{
    "name": "jeffersongoncalves/bb-cli",
    "description": "A modern Bitbucket Cloud CLI built with Laravel Zero. Manage pull requests, pipelines, branches, environments, and more from your terminal.",
    "keywords": ["bitbucket", "bitbucket-cloud", "cli", "laravel-zero", "pull-request", "pipeline", "devtools", "bitbucket-api"],
    "homepage": "https://github.com/jeffersongoncalves/bb-cli",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Goncalves",
            "email": "jeff@jeffersongoncalves.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "jeffersongoncalves/laravel-zero-api-client": "^1.0",
        "jeffersongoncalves/laravel-zero-console": "^1.0",
        "jeffersongoncalves/laravel-zero-credentials": "^1.0",
        "jeffersongoncalves/laravel-zero-git": "^1.0",
        "jeffersongoncalves/laravel-zero-self-update": "^1.0",
        "jeffersongoncalves/laravel-zero-support": "^1.0",
        "laravel-zero/framework": "^12.0.2",
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": "php bb app:build bb --build-version=\"$(git describe --tags --abbrev=0 2>/dev/null || echo unreleased)\"",
        "lint": "./vendor/bin/pint",
        "refactor": "./vendor/bin/rector process",
        "test:lint": "./vendor/bin/pint --test",
        "test:unit": "./vendor/bin/pest --parallel",
        "test:unit:coverage": "./vendor/bin/pest --parallel --coverage",
        "test:types": "./vendor/bin/phpstan analyse --memory-limit=256M",
        "test:refactor": "./vendor/bin/rector process --dry-run",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=256M",
        "phpstan-baseline": "./vendor/bin/phpstan analyse --generate-baseline --memory-limit=256M",
        "test": [
            "@test:unit",
            "@test:lint"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["builds/bb"]
}
