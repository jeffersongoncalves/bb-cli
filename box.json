{
    "chmod": "0755",
    "directories": [
        "app",
        "bootstrap",
        "config",
        "vendor"
    ],
    "files": [
        "composer.json",
        "composer.lock"
    ],
    "exclude-composer-files": false,
    "exclude-dev-files": false,
    "compression": "GZ",
    "compactors": [
        "KevinGH\\Box\\Compactor\\Php",
        "KevinGH\\Box\\Compactor\\Json"
    ],
    "force-autodiscovery": true,
    "composer-install": true,
    "composer-require-dev": true,
    "check-requirements": true
}
